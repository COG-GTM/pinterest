{
  "name": "pinwork",
  "license": "MIT",
  "angular-cli": {},
  "scripts": {
    "ng": "./node_modules/@angular/cli/bin/ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "mock-api": "node mock-api/server.js",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "compodoc": "./node_modules/.bin/compodoc -p src/tsconfig.json",
    "build--prod": "ng build --configuration production --no-sourcemap --stats-json && npm run sw",
    "sw": "sw-precache --root=dist --config=sw-precache-config.js",
    "static-serve": "cd dist && live-server --port=4200 --host=localhost --entry-file=/index.html"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~13.4.0",
    "@angular/common": "~13.4.0",
    "@angular/compiler": "~13.4.0",
    "@angular/compiler-cli": "~13.4.0",
    "@angular/core": "~13.4.0",
    "@angular/forms": "~13.4.0",
    "@angular/platform-browser": "~13.4.0",
    "@angular/platform-browser-dynamic": "~13.4.0",
    "@angular/platform-server": "~13.4.0",
    "@angular/router": "~13.4.0",
    "@ngrx/effects": "~13.2.0",
    "@ngrx/router-store": "~13.2.0",
    "@ngrx/store": "~13.2.0",
    "angular2-infinite-scroll": "^0.2.6",
    "angular2-toaster": "~11.0.1",
    "core-js": "^2.4.1",
    "firebase": "~9.23.0",
    "font-awesome": "^4.7.0",
    "foundation-sites": "^6.3.0",
    "imagesloaded": "^4.1.1",
    "masonry-layout": "~4.1.1",
    "ng2-progressbar": "^1.3.0",
    "ngx-chips": "~2.1.0",
    "phoenix_js": "0.0.3",
    "reselect": "^2.5.4",
    "rxjs": "~6.6.7",
    "rxjs-compat": "~6.6.7",
    "ts-helpers": "^1.1.1",
    "tslib": "^2.0.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~13.3.11",
    "@angular/cli": "~13.3.11",
    "@ngrx/store-devtools": "~13.2.0",
    "@types/jasmine": "~3.6.0",
    "@types/node": "^12.11.1",
    "codelyzer": "^6.0.0",
    "jasmine-core": "~3.6.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-cli": "~1.0.1",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "live-server": "^1.2.0",
    "protractor": "~7.0.0",
    "raw-loader": "^0.5.1",
    "sw-precache": "^5.0.0",
    "ts-node": "~2.0.0",
    "tslint": "~6.1.0",
    "typescript": "~4.6.4"
  },
  "description": "Pinterest for bloggers",
  "main": "index.js",
  "repository": "git@github.com:aviabird/pinterest.git",
  "author": "Pankaj Rawat <pankajrawat19sept@gmail.com>",
