    "ng2-slim-loading-bar": "^2.4.0",
    "ngx-chips": "~1.9.8",
    "phoenix_js": "0.0.3",
    "reselect": "^2.5.4",
    "rxjs": "~6.6.7",
    "rxjs-compat": "~6.6.7",
    "ts-helpers": "^1.1.1",
    "tslib": "^1.9.0",
    "zone.js": "~0.8.26"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~0.13.0",
    "@angular/cli": "~7.3.10",
    "@ngrx/store-devtools": "~7.4.0",
