{
  "name": "pinwork",
  "license": "MIT",
  "angular-cli": {},
  "scripts": {
    "ng": "./node_modules/@angular/cli/bin/ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "mock-api": "node mock-api/server.js",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "compodoc": "./node_modules/.bin/compodoc -p src/tsconfig.json",
    "build--prod": "ng build --prod --no-sourcemap --stats-json && npm run sw",
    "sw": "sw-precache --root=dist --config=sw-precache-config.js",
    "static-serve": "cd dist && live-server --port=4200 --host=localhost --entry-file=/index.html"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~7.2.16",
    "@angular/common": "~7.2.16",
