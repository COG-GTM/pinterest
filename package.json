    "live-server": "^1.2.0",
    "ngrx-store-freeze": "~0.2.4",
    "node-sass": "~4.14.1",
    "protractor": "~5.1.0",
    "raw-loader": "^0.5.1",
    "sass-loader": "^6.0.3",
    "sw-precache": "^5.0.0",
    "ts-node": "~2.0.0",
    "tslint": "~4.4.2",
